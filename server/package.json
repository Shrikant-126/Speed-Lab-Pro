{
  "name": "@speedlab/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SpeedLab Pro REST API (Express) – runs locally or as a Vercel Function",
  "main": "src/index.js",
  "exports": {
    ".": "./src/app.js"
