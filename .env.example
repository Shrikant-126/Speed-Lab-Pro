# ─────────────────────────────────────────────────────────────
# SpeedLab Pro – environment variables
# Copy to .env (never commit .env). Variables prefixed with VITE_
# are exposed to the browser – NEVER put secrets in VITE_ vars.
# ─────────────────────────────────────────────────────────────

# --- Google APIs (server/worker only) ---------------------------
# Create a key at https://console.cloud.google.com/apis/credentials and enable
# "PageSpeed Insights API" and "Chrome UX Report API".
PAGESPEED_API_KEY=
# Optional separate key for CrUX (defaults to PAGESPEED_API_KEY)
CRUX_API_KEY=

# --- Lighthouse ---------------------------------------------------
# psi                 = Lighthouse via PageSpeed Insights (default, no local Chrome needed)
# local               = run Lighthouse in the worker (needs lighthouse + chrome-launcher)
# psi-fallback-local  = PSI first, local Lighthouse if PSI fails (quota, timeouts)
LIGHTHOUSE_MODE=psi
# Optional: path to Chrome/Chromium (otherwise Playwright's Chromium is used)
CHROME_PATH=

# --- Worker -------------------------------------------------------
# Empty in local development → the API runs scans in-process.
# In production set it to the worker's public URL, e.g. https://speedlab-worker.fly.dev
WORKER_URL=
# Shared secret between API and worker (long random string; required in production)
WORKER_SECRET=
WORKER_PORT=8787
WORKER_CONCURRENCY=2
# Set true to skip Playwright inspection (e.g. on very small machines)
DISABLE_BROWSER=false
IMAGE_PROBE_MAX=15

# --- API server -----------------------------------------------------
PORT=8080
CORS_ORIGINS=http://localhost:5173
SCAN_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=30
API_RATE_LIMIT=600
# Local JSON storage directory when Supabase is not configured
DATA_DIR=./data

# --- Supabase (server/worker) ----------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (browser – public anon key only) -----------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: API base URL if the frontend is hosted separately from the API
VITE_API_BASE=
